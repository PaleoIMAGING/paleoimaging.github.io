---
layout: null
sitemap: false
---
[
{%- assign first = true -%}
{%- assign items = site.pages | concat: site.posts -%}
{%- for p in items -%}
  {%- if p.title and p.noindex != true and p.url != '/meetings/submit/' -%}
  {%- unless first %},{% endunless -%}
  {%- assign first = false %}
  {"title": {{ p.title | jsonify }}, "url": {{ p.url | relative_url | jsonify }}, "text": {{ p.content | strip_html | replace: '
', ' ' | normalize_whitespace | truncate: 1500 | jsonify }}}
  {%- endif -%}
{%- endfor %}
]
