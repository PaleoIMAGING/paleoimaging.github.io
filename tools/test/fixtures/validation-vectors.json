{
  "description": "Portable validation contract. Every consumer of meetings-validate.js (website CI, browser form, Cloudflare Worker) runs these same vectors against the shared _data/meetings_config.yml. `patch` overrides fields of `base`; `drop` removes fields; `expect` lists substrings that must appear in the error list (empty list = must be valid).",
  "base": {
    "schema_version": 1,
    "id": "ok",
    "title": "A meeting",
    "wgs": [
      "wg1"
    ],
    "type": "workshop",
    "format": "online",
    "start": "2026-11-10T14:00",
    "end": "2026-11-10T15:00",
    "timezone": "Europe/Warsaw",
    "access": "public",
    "url": "https://example.org/x",
    "organizers": [
      {
        "name": "A. Person",
        "affiliation": "Somewhere"
      }
    ]
  },
  "cases": [
    {
      "name": "minimal good record",
      "expect": []
    },
    {
      "name": "several working groups",
      "patch": {
        "wgs": [
          "wg1",
          "wg2",
          "wg3"
        ]
      },
      "expect": []
    },
    {
      "name": "unknown field",
      "patch": {
        "admin_notes": "x"
      },
      "expect": [
        "admin_notes: unknown field"
      ]
    },
    {
      "name": "organizer email rejected",
      "patch": {
        "organizers": [
          {
            "name": "A",
            "email": "a@example.org"
          }
        ]
      },
      "expect": [
        "contact details stay private"
      ]
    },
    {
      "name": "contact field rejected",
      "patch": {
        "contact_email": "a@example.org"
      },
      "expect": [
        "unknown field"
      ]
    },
    {
      "name": "missing title",
      "drop": [
        "title"
      ],
      "expect": [
        "title: required"
      ]
    },
    {
      "name": "unquoted-style time",
      "patch": {
        "start": "2026-11-10 14:00"
      },
      "expect": [
        "start: must be a quoted local time"
      ]
    },
    {
      "name": "impossible date",
      "patch": {
        "start": "2026-02-30T10:00"
      },
      "expect": [
        "start:"
      ]
    },
    {
      "name": "bad time zone",
      "patch": {
        "timezone": "Mars/Base"
      },
      "expect": [
        "timezone"
      ]
    },
    {
      "name": "end before start",
      "patch": {
        "end": "2026-11-10T13:00"
      },
      "expect": [
        "end: must be after start"
      ]
    },
    {
      "name": "too long",
      "patch": {
        "end": "2026-12-10T13:00"
      },
      "expect": [
        "longer than 14 days"
      ]
    },
    {
      "name": "unknown working group",
      "patch": {
        "wgs": [
          "wg9"
        ]
      },
      "expect": [
        "unknown working group \"wg9\""
      ]
    },
    {
      "name": "duplicate working group",
      "patch": {
        "wgs": [
          "wg1",
          "wg1"
        ]
      },
      "expect": [
        "duplicate"
      ]
    },
    {
      "name": "sc alone is valid",
      "patch": {
        "wgs": [
          "sc"
        ]
      },
      "expect": []
    },
    {
      "name": "sc can combine with a working group",
      "patch": {
        "wgs": [
          "sc",
          "wg2"
        ]
      },
      "expect": []
    },
    {
      "name": "general cannot combine with sc",
      "patch": {
        "wgs": [
          "general",
          "sc"
        ]
      },
      "expect": [
        "cannot be combined"
      ]
    },
    {
      "name": "general cannot combine",
      "patch": {
        "wgs": [
          "general",
          "wg2"
        ]
      },
      "expect": [
        "cannot be combined"
      ]
    },
    {
      "name": "in-person needs venue",
      "patch": {
        "format": "in-person"
      },
      "expect": [
        "location.venue: required for in-person"
      ]
    },
    {
      "name": "hybrid needs location",
      "patch": {
        "format": "hybrid"
      },
      "expect": [
        "required for hybrid"
      ]
    },
    {
      "name": "valid in-person",
      "patch": {
        "format": "in-person",
        "access": "private",
        "access_note": "By invitation",
        "location": {
          "venue": "V",
          "city": "C",
          "country": "X"
        }
      },
      "drop": [
        "url"
      ],
      "expect": []
    },
    {
      "name": "public in-person needs no join link",
      "patch": {
        "format": "in-person",
        "location": {
          "venue": "V",
          "city": "C",
          "country": "X"
        }
      },
      "drop": [
        "url"
      ],
      "expect": []
    },
    {
      "name": "in-person cannot publish a join link",
      "patch": {
        "format": "in-person",
        "location": {
          "venue": "V",
          "city": "C",
          "country": "X"
        }
      },
      "expect": [
        "in-person meetings have no join link"
      ]
    },
    {
      "name": "platform accepted",
      "patch": {
        "platform": "Zoom"
      },
      "expect": []
    },
    {
      "name": "platform too long",
      "patch": {
        "platform": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      },
      "expect": [
        "platform: must be at most 60"
      ]
    },
    {
      "name": "email in description rejected",
      "patch": {
        "description": "Contact me at someone@example.org"
      },
      "expect": [
        "description: must not contain email addresses"
      ]
    },
    {
      "name": "email in organizer name rejected",
      "patch": {
        "organizers": [
          {
            "name": "a@b.org"
          }
        ]
      },
      "expect": [
        "must not contain email addresses"
      ]
    },
    {
      "name": "web address in description rejected",
      "patch": {
        "description": "Join at https://zoom.example/j/123"
      },
      "expect": [
        "description: must not contain web addresses"
      ]
    },
    {
      "name": "bare domain with path rejected",
      "patch": {
        "description": "Join at zoom.us/j/12345"
      },
      "expect": [
        "must not contain web addresses"
      ]
    },
    {
      "name": "web address in private note rejected",
      "patch": {
        "access": "private",
        "access_note": "Link: https://zoom.example/j/1"
      },
      "drop": [
        "url"
      ],
      "expect": [
        "access_note: must not contain web addresses"
      ]
    },
    {
      "name": "web address in title rejected",
      "patch": {
        "title": "See www.example.org now"
      },
      "expect": [
        "title: must not contain web addresses"
      ]
    },
    {
      "name": "ordinary prose with dots and slashes is fine",
      "patch": {
        "description": "e.g. WG1/WG2 and/or i.e. 10.5 results. Agenda to follow."
      },
      "expect": []
    },
    {
      "name": "private cannot carry join link",
      "patch": {
        "access": "private",
        "access_note": "Members only"
      },
      "expect": [
        "url: must not be published"
      ]
    },
    {
      "name": "private needs note",
      "patch": {
        "access": "private"
      },
      "drop": [
        "url"
      ],
      "expect": [
        "access_note: required"
      ]
    },
    {
      "name": "registration needs link",
      "patch": {
        "access": "registration"
      },
      "drop": [
        "url"
      ],
      "expect": [
        "registration_url: required"
      ]
    },
    {
      "name": "registration link only for registration",
      "patch": {
        "registration_url": "https://example.org/r"
      },
      "expect": [
        "registration_url: only allowed"
      ]
    },
    {
      "name": "javascript URL",
      "patch": {
        "url": "javascript:alert(1)"
      },
      "expect": [
        "url:"
      ]
    },
    {
      "name": "http URL",
      "patch": {
        "url": "http://example.org"
      },
      "expect": [
        "must use https"
      ]
    },
    {
      "name": "URL credentials",
      "patch": {
        "url": "https://user:pw@example.org"
      },
      "expect": [
        "credentials"
      ]
    },
    {
      "name": "insecure resource link",
      "patch": {
        "links": [
          {
            "label": "x",
            "url": "http://insecure.example"
          }
        ]
      },
      "expect": [
        "links[0].url"
      ]
    },
    {
      "name": "script in title",
      "patch": {
        "title": "<script>alert(1)</script>"
      },
      "expect": [
        "markup or control"
      ]
    },
    {
      "name": "markup in description",
      "patch": {
        "description": "hello <b>x</b>"
      },
      "expect": [
        "markup or control"
      ]
    },
    {
      "name": "bidi override",
      "patch": {
        "title": "evil‮txt"
      },
      "expect": [
        "markup or control"
      ]
    },
    {
      "name": "control character",
      "patch": {
        "title": "nul\u0000"
      },
      "expect": [
        "markup or control"
      ]
    },
    {
      "name": "markup in organizer",
      "patch": {
        "organizers": [
          {
            "name": "<img src=x>"
          }
        ]
      },
      "expect": [
        "organizers[0].name"
      ]
    },
    {
      "name": "title too long",
      "patch": {
        "title": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      },
      "expect": [
        "at most 120"
      ]
    },
    {
      "name": "id not a slug",
      "patch": {
        "id": "Bad Id"
      },
      "expect": [
        "id:"
      ]
    },
    {
      "name": "weekly series",
      "patch": {
        "recurrence": {
          "freq": "weekly",
          "count": 5
        }
      },
      "expect": []
    },
    {
      "name": "series needs end",
      "patch": {
        "recurrence": {
          "freq": "weekly"
        }
      },
      "expect": [
        "needs until or count"
      ]
    },
    {
      "name": "unknown frequency",
      "patch": {
        "recurrence": {
          "freq": "hourly",
          "count": 2
        }
      },
      "expect": [
        "recurrence.freq"
      ]
    },
    {
      "name": "until and count",
      "patch": {
        "recurrence": {
          "freq": "weekly",
          "count": 2,
          "until": "2027-01-01"
        }
      },
      "expect": [
        "either until or count"
      ]
    },
    {
      "name": "huge count",
      "patch": {
        "recurrence": {
          "freq": "daily",
          "count": 100000
        }
      },
      "expect": [
        "recurrence.count"
      ]
    },
    {
      "name": "zero interval",
      "patch": {
        "recurrence": {
          "freq": "daily",
          "count": 3,
          "interval": 0
        }
      },
      "expect": [
        "recurrence.interval"
      ]
    },
    {
      "name": "plain weekday on monthly is rejected (needs an ordinal)",
      "patch": {
        "recurrence": {
          "freq": "monthly",
          "count": 3,
          "byday": [
            "MO"
          ]
        }
      },
      "expect": [
        "recurrence.byday"
      ]
    },
    {
      "name": "byday on daily",
      "patch": {
        "recurrence": {
          "freq": "daily",
          "count": 3,
          "byday": [
            "2TU"
          ]
        }
      },
      "expect": [
        "only valid for weekly and monthly"
      ]
    },
    {
      "name": "monthly second weekday is valid when the first meeting falls on it",
      "patch": {
        "recurrence": {
          "freq": "monthly",
          "count": 3,
          "byday": [
            "2TU"
          ]
        }
      },
      "expect": []
    },
    {
      "name": "monthly ordinal weekday must match the first meeting",
      "patch": {
        "recurrence": {
          "freq": "monthly",
          "count": 3,
          "byday": [
            "2TH"
          ]
        }
      },
      "expect": [
        "first meeting must fall on the second Thursday"
      ]
    },
    {
      "name": "monthly ordinal weekday must be one entry",
      "patch": {
        "recurrence": {
          "freq": "monthly",
          "count": 3,
          "byday": [
            "2TU",
            "3TU"
          ]
        }
      },
      "expect": [
        "must be one ordinal weekday"
      ]
    },
    {
      "name": "monthly ordinal out of range",
      "patch": {
        "recurrence": {
          "freq": "monthly",
          "count": 3,
          "byday": [
            "5TU"
          ]
        }
      },
      "expect": [
        "must be one ordinal weekday"
      ]
    },
    {
      "name": "bad weekday",
      "patch": {
        "recurrence": {
          "freq": "weekly",
          "count": 3,
          "byday": [
            "XX"
          ]
        }
      },
      "expect": [
        "recurrence.byday"
      ]
    },
    {
      "name": "bad exception date",
      "patch": {
        "recurrence": {
          "freq": "weekly",
          "count": 3,
          "exceptions": [
            "nope"
          ]
        }
      },
      "expect": [
        "exceptions"
      ]
    },
    {
      "name": "unknown recurrence field",
      "patch": {
        "recurrence": {
          "freq": "weekly",
          "count": 3,
          "evil": 1
        }
      },
      "expect": [
        "recurrence.evil"
      ]
    },
    {
      "name": "unbounded-in-practice series",
      "patch": {
        "recurrence": {
          "freq": "daily",
          "until": "2099-01-01"
        }
      },
      "expect": [
        "more than 260"
      ]
    },
    {
      "name": "empty organizer list rejected",
      "patch": {
        "organizers": []
      },
      "expect": [
        "organizers: must be a list of 1 to"
      ]
    },
    {
      "name": "script breakout in URL rejected",
      "patch": {
        "url": "https://example.org/?q=</script><script>alert(1)//"
      },
      "expect": [
        "url: must not contain < or >"
      ]
    },
    {
      "name": "angle brackets in registration URL rejected",
      "patch": {
        "access": "registration",
        "registration_url": "https://example.org/<b>"
      },
      "drop": [
        "url"
      ],
      "expect": [
        "registration_url: must not contain < or >"
      ]
    }
  ]
}
